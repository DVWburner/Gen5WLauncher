<Window x:Class="Gen5WStudio.UploadThemeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Package &amp; Upload Single Theme to Theme Store"
        Width="980" Height="740"
        MinWidth="860" MinHeight="640"
        WindowStartupLocation="CenterOwner"
        Background="#FF0F172A"
        Foreground="#FFF8FAFC">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#FF1E293B"/>
            <Setter Property="Foreground" Value="#FFF8FAFC"/>
            <Setter Property="BorderBrush" Value="#FF334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF334155"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#FF111827"/>
            <Setter Property="Foreground" Value="#FFF8FAFC"/>
            <Setter Property="BorderBrush" Value="#FF334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="CaretBrush" Value="#FF38BDF8"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#FF111827"/>
            <Setter Property="Foreground" Value="#FF0F172A"/>
            <Setter Property="BorderBrush" Value="#FF334155"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF94A3B8"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,6,0,2"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="Export &amp; Upload Single Theme to Store" FontSize="18" FontWeight="Bold" Foreground="#FF38BDF8"/>
                <TextBlock Text="Packages ONLY the currently active theme (never a whole multi-theme pack), captures thumbnail.png, writes manifest.json, and enforces safety checks."
                           Foreground="#FF94A3B8" FontSize="12" Margin="0,2,0,0"/>
            </StackPanel>
            <Border DockPanel.Dock="Right" Background="#FF0F766E" BorderBrush="#FF14B8A6" BorderThickness="1" CornerRadius="6" Padding="10,4" VerticalAlignment="Center">
                <TextBlock Text="SINGLE THEME ONLY (1 / UPLOAD)" Foreground="#FFECFEFF" FontSize="11" FontWeight="Bold"/>
            </Border>
        </DockPanel>

        <!-- CREATOR ACCOUNT BAR -->
        <Border Grid.Row="1" Background="#FF111827" BorderBrush="#FF334155" BorderThickness="1" CornerRadius="8" Padding="10,7" Margin="0,0,0,10">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="AccountSignInBtn" Content="Sign In / Register..." Padding="10,4" FontSize="12"
                            Background="#FF1D4ED8" BorderBrush="#FF3B82F6" Click="OnAccountSignInClick"/>
                    <Button x:Name="AccountSignOutBtn" Content="Sign Out" Padding="10,4" FontSize="12" Margin="6,0,0,0"
                            Visibility="Collapsed" Click="OnAccountSignOutClick"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="CREATOR ACCOUNT:" Foreground="#FF64748B" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock x:Name="AccountStatusText" Text="Not signed in — sign in or create an account to upload (local .zip export works anytime)."
                               Foreground="#FFCBD5E1" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- BODY -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="0.9*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: METADATA FORM -->
            <Border Grid.Column="0" Background="#FF1E293B" BorderBrush="#FF334155" BorderThickness="1" CornerRadius="8" Padding="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="THEME STORE METADATA" FontWeight="Bold" Foreground="#FF38BDF8" FontSize="12" Margin="0,0,0,4"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.3*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Theme Display Name *" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="NameBox"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Theme ID (slug) *" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="IdBox"/>
                            </StackPanel>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="0.9*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Author *" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="AuthorBox"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Theme Version *" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="VersionBox"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Revision #" Style="{StaticResource FieldLabel}"/>
                                <DockPanel>
                                    <Button Content="+1" DockPanel.Dock="Right" Padding="8,4" Margin="4,0,0,0" ToolTip="Bump revision number" Click="OnBumpRevisionClick"/>
                                    <TextBox x:Name="RevisionBox"/>
                                </DockPanel>
                            </StackPanel>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="1.2*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Store Category *" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="CategoryCombo" IsEditable="False"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Compatible Software Versions (comma-separated)" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="CompatVersionsBox" ToolTip="Example: 0.3.4+, 0.3.4, 0.3.5"/>
                            </StackPanel>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Minimum App Version" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="MinAppVersionBox"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Release Timestamp (UTC)" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="DatePreviewBox" IsReadOnly="True" Opacity="0.8"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Description / Release Notes" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="DescriptionBox" Height="78" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>

                        <TextBlock Text="Marketplace Endpoint URL (HTTPS)" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="StoreUrlBox" LostFocus="OnStoreUrlLostFocus"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- RIGHT: THUMBNAIL + SECURITY AUDIT -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- THUMBNAIL PREVIEW -->
                <Border Grid.Row="0" Background="#FF1E293B" BorderBrush="#FF334155" BorderThickness="1" CornerRadius="8" Padding="12">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,6">
                            <Button Content="Recapture Live Canvas" DockPanel.Dock="Right" Padding="8,3" FontSize="11" Click="OnRecaptureThumbnailClick"/>
                            <TextBlock Text="INCLUDED THUMBNAIL (thumbnail.png)" FontWeight="Bold" Foreground="#FF38BDF8" FontSize="12" VerticalAlignment="Center"/>
                        </DockPanel>
                        <Border Background="#FF020617" BorderBrush="#FF334155" BorderThickness="1" CornerRadius="6" Height="150" Padding="4">
                            <Image x:Name="ThumbnailPreviewImage" Stretch="Uniform"/>
                        </Border>
                        <TextBlock x:Name="ThumbnailInfoText" Text="960 x 360 PNG" Foreground="#FF94A3B8" FontSize="11" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <!-- SECURITY AUDIT LOG -->
                <Border Grid.Row="2" Background="#FF1E293B" BorderBrush="#FF334155" BorderThickness="1" CornerRadius="8" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="0,0,0,6">
                            <Button Content="Re-Scan" DockPanel.Dock="Right" Padding="8,3" FontSize="11" Click="OnRescanClick"/>
                            <TextBlock Text="SAFETY &amp; SINGLE-THEME AUDIT" FontWeight="Bold" Foreground="#FF38BDF8" FontSize="12" VerticalAlignment="Center"/>
                        </DockPanel>
                        <Border x:Name="AuditBadgeBorder" Grid.Row="1" CornerRadius="5" Padding="8,5" Margin="0,0,0,8" Background="#FF064E3B" BorderBrush="#FF10B981" BorderThickness="1">
                            <TextBlock x:Name="AuditSummaryText" Text="Scanning..." Foreground="#FFD1FAE5" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        </Border>
                        <TextBox x:Name="AuditDetailsBox" Grid.Row="2" IsReadOnly="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- FOOTER ACTIONS -->
        <DockPanel Grid.Row="3" Margin="0,12,0,0" LastChildFill="False">
            <TextBlock x:Name="StatusText" DockPanel.Dock="Left" Text="Ready to verify &amp; package active theme."
                       Foreground="#FFCBD5E1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="460"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="SaveZipBtn" Content="Save Safe Theme .zip..." Margin="0,0,8,0"
                        Background="#FF1D4ED8" BorderBrush="#FF3B82F6" Click="OnSaveZipClick"/>
                <Button x:Name="UploadStoreBtn" Content="Upload to Theme Store" Margin="0,0,8,0"
                        Background="#FF065F46" BorderBrush="#FF10B981" Click="OnUploadClick"/>
                <Button Content="Close" Click="OnCloseClick"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
