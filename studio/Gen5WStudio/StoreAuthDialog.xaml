<Window x:Class="Gen5WStudio.StoreAuthDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Theme Store Account"
        Width="490" Height="560"
        MinWidth="450" MinHeight="500"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterOwner"
        Background="#FF0F172A"
        Foreground="#FFF8FAFC">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#FF1E293B"/>
            <Setter Property="Foreground" Value="#FFF8FAFC"/>
            <Setter Property="BorderBrush" Value="#FF334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF334155"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#FF111827"/>
            <Setter Property="Foreground" Value="#FFF8FAFC"/>
            <Setter Property="BorderBrush" Value="#FF334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="9,6"/>
            <Setter Property="CaretBrush" Value="#FF38BDF8"/>
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="#FF111827"/>
            <Setter Property="Foreground" Value="#FFF8FAFC"/>
            <Setter Property="BorderBrush" Value="#FF334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="9,6"/>
            <Setter Property="CaretBrush" Value="#FF38BDF8"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF94A3B8"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,8,0,3"/>
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="#FF1E293B"/>
            <Setter Property="BorderBrush" Value="#FF334155"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#FF94A3B8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBd" Background="#FF0F172A" BorderBrush="#FF334155" BorderThickness="1,1,1,0"
                                CornerRadius="6,6,0,0" Margin="0,0,4,0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBd" Property="Background" Value="#FF1E293B"/>
                                <Setter Property="Foreground" Value="#FF38BDF8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Theme Store Creator Account" FontSize="18" FontWeight="Bold" Foreground="#FF38BDF8"/>
            <TextBlock x:Name="OriginText" Text="https://market.ioniqthemes.com" Foreground="#FF94A3B8" FontSize="12" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- SESSION BANNER -->
        <Border x:Name="BannerBorder" Grid.Row="1" Visibility="Collapsed"
                Background="#FF451A03" BorderBrush="#FFF59E0B" BorderThickness="1" CornerRadius="6" Padding="10,7" Margin="0,0,0,10">
            <TextBlock x:Name="BannerText" Foreground="#FFFDE68A" FontSize="12" TextWrapping="Wrap"/>
        </Border>

        <!-- TABS -->
        <TabControl x:Name="AuthTabs" Grid.Row="2" Padding="14">
            <!-- SIGN IN TAB -->
            <TabItem Header="Sign In">
                <StackPanel>
                    <TextBlock Text="Sign in with your creator account to upload new themes, publish updates, or manage themes you own."
                               Foreground="#FFCBD5E1" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"/>

                    <TextBlock Text="Username" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="LoginUsernameBox" KeyDown="OnLoginKeyDown"/>

                    <TextBlock Text="Password" Style="{StaticResource FieldLabel}"/>
                    <PasswordBox x:Name="LoginPasswordBox" KeyDown="OnLoginKeyDown"/>

                    <Border Background="#FF0F172A" BorderBrush="#FF334155" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,14,0,0">
                        <TextBlock Text="Your username stays strictly private on the Store. Only your Theme Author display name is shown publicly."
                                   Foreground="#FF94A3B8" FontSize="11" TextWrapping="Wrap"/>
                    </Border>

                    <Button x:Name="SignInSubmitBtn" Content="Sign In" Background="#FF065F46" BorderBrush="#FF10B981"
                            Margin="0,16,0,0" Padding="14,9" Click="OnSignInSubmitClick"/>
                </StackPanel>
            </TabItem>

            <!-- CREATE ACCOUNT TAB -->
            <TabItem Header="Create Account">
                <StackPanel>
                    <Border Background="#FF451A03" BorderBrush="#FFF59E0B" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                        <TextBlock Text="Important: Accounts use only a username and password — there is no email or password reset. Please save your credentials somewhere safe."
                                   Foreground="#FFFDE68A" FontSize="11.5" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    </Border>

                    <TextBlock Text="Username (3–32 characters: letters, numbers, _ or -)" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="RegUsernameBox" KeyDown="OnRegisterKeyDown"/>

                    <TextBlock Text="Password (8–128 characters)" Style="{StaticResource FieldLabel}"/>
                    <PasswordBox x:Name="RegPasswordBox" KeyDown="OnRegisterKeyDown"/>

                    <TextBlock Text="Confirm Password" Style="{StaticResource FieldLabel}"/>
                    <PasswordBox x:Name="RegConfirmPasswordBox" KeyDown="OnRegisterKeyDown"/>

                    <TextBlock Text="Your username stays private; public listings display the Theme Author name from your theme metadata."
                               Foreground="#FF94A3B8" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0"/>

                    <Button x:Name="RegisterSubmitBtn" Content="Create Account &amp; Sign In" Background="#FF1D4ED8" BorderBrush="#FF3B82F6"
                            Margin="0,14,0,0" Padding="14,9" Click="OnRegisterSubmitClick"/>
                </StackPanel>
            </TabItem>
        </TabControl>

        <!-- ERROR DISPLAY -->
        <Border x:Name="ErrorBorder" Grid.Row="3" Visibility="Collapsed"
                Background="#FF7F1D1D" BorderBrush="#FFEF4444" BorderThickness="1" CornerRadius="6" Padding="10,7" Margin="0,10,0,0">
            <TextBlock x:Name="ErrorText" Foreground="#FFFECACA" FontSize="12" TextWrapping="Wrap"/>
        </Border>

        <!-- FOOTER -->
        <DockPanel Grid.Row="4" Margin="0,12,0,0" LastChildFill="False">
            <TextBlock x:Name="BusyStatusText" DockPanel.Dock="Left" Text="" Foreground="#FF94A3B8" FontSize="12" VerticalAlignment="Center"/>
            <Button DockPanel.Dock="Right" Content="Cancel" Click="OnCancelClick"/>
        </DockPanel>
    </Grid>
</Window>
