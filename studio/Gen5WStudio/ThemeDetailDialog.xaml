<Window x:Class="Gen5WStudio.ThemeDetailDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Theme Preview &amp; Details"
        Width="1020" Height="740"
        MinWidth="820" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        Background="#FF0B1120"
        Foreground="#FFF8FAFC">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#FF1E293B"/>
            <Setter Property="Foreground" Value="#FFF8FAFC"/>
            <Setter Property="BorderBrush" Value="#FF334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF334155"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MetaLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF64748B"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>

        <Style x:Key="MetaValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFE2E8F0"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12" LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                <Border x:Name="CategoryPill" Background="#FF0F766E" BorderBrush="#FF14B8A6" BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="0,0,6,0">
                    <TextBlock x:Name="CategoryBadgeText" Text="Category" Foreground="#FFECFEFF" FontSize="11.5" FontWeight="Bold"/>
                </Border>
                <Border Background="#FF1E293B" BorderBrush="#FF334155" BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="0,0,6,0">
                    <TextBlock x:Name="VersionBadgeText" Text="v1.0.0 · rev 1" Foreground="#FF38BDF8" FontSize="11.5" FontWeight="Bold"/>
                </Border>
                <Border x:Name="OwnerBadgeBorder" Background="#FF1D4ED8" BorderBrush="#FF3B82F6" BorderThickness="1" CornerRadius="6" Padding="10,4" Visibility="Collapsed">
                    <TextBlock Text="YOUR THEME" Foreground="White" FontSize="11.5" FontWeight="Bold"/>
                </Border>
            </StackPanel>
            <StackPanel>
                <TextBlock x:Name="TitleText" Text="Theme Name" FontSize="20" FontWeight="Bold" Foreground="White" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="SubtitleAuthorText" Text="by Author" Foreground="#FF94A3B8" FontSize="12.5" Margin="0,2,0,0"/>
            </StackPanel>
        </DockPanel>

        <!-- LARGE NATIVE-RESOLUTION WIDESCREEN PREVIEW -->
        <Border Grid.Row="1" Background="#FF020617" BorderBrush="#FF334155" BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" MinHeight="280" MaxHeight="390">
                    <TextBlock x:Name="PreviewPlaceholderText" Text="Loading full preview..."
                               Foreground="#FF64748B" FontSize="14" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Image x:Name="PreviewImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Grid>

                <DockPanel Grid.Row="1" Margin="2,6,2,0">
                    <TextBlock x:Name="PreviewDimText" DockPanel.Dock="Right" Text="" Foreground="#FF64748B" FontSize="11"/>
                    <TextBlock x:Name="PreviewHintText" Text="Live Canvas Preview" Foreground="#FF94A3B8" FontSize="11"/>
                </DockPanel>
            </Grid>
        </Border>

        <!-- DETAILS & DESCRIPTION -->
        <Border Grid.Row="2" Background="#FF111827" BorderBrush="#FF1E293B" BorderThickness="1" CornerRadius="8" Padding="14">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="CATEGORY" Style="{StaticResource MetaLabel}"/>
                            <TextBlock x:Name="CategoryDetailText" Style="{StaticResource MetaValue}" Foreground="#FF34D399" FontWeight="SemiBold" Margin="0,0,0,10"/>

                            <TextBlock Text="THEME ID" Style="{StaticResource MetaLabel}"/>
                            <TextBlock x:Name="IdDetailText" Style="{StaticResource MetaValue}" FontFamily="Consolas" Margin="0,0,0,10"/>

                            <TextBlock Text="UPDATED / PUBLISHED" Style="{StaticResource MetaLabel}"/>
                            <TextBlock x:Name="DatesDetailText" Style="{StaticResource MetaValue}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="AUTHOR" Style="{StaticResource MetaLabel}"/>
                            <TextBlock x:Name="AuthorDetailText" Style="{StaticResource MetaValue}" Margin="0,0,0,10"/>

                            <TextBlock Text="COMPATIBLE SOFTWARE" Style="{StaticResource MetaLabel}"/>
                            <TextBlock x:Name="CompatDetailText" Style="{StaticResource MetaValue}" Foreground="#FF34D399" Margin="0,0,0,10"/>

                            <TextBlock Text="DISPLAY MODE" Style="{StaticResource MetaLabel}"/>
                            <TextBlock x:Name="SystemBarDetailText" Style="{StaticResource MetaValue}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <TextBlock Text="VERSION / REVISION" Style="{StaticResource MetaLabel}"/>
                            <TextBlock x:Name="VersionDetailText" Style="{StaticResource MetaValue}" Margin="0,0,0,10"/>

                            <TextBlock Text="SIZE &amp; DOWNLOADS" Style="{StaticResource MetaLabel}"/>
                            <TextBlock x:Name="SizeDownloadsDetailText" Style="{StaticResource MetaValue}" Margin="0,0,0,10"/>

                            <TextBlock Text="PACKAGE SHA-256" Style="{StaticResource MetaLabel}"/>
                            <TextBlock x:Name="Sha256DetailText" Style="{StaticResource MetaValue}" FontFamily="Consolas" FontSize="11"/>
                        </StackPanel>
                    </Grid>

                    <!-- TAGS -->
                    <StackPanel x:Name="TagsSection" Visibility="Collapsed" Margin="0,0,0,12">
                        <TextBlock Text="TAGS" Style="{StaticResource MetaLabel}" Margin="0,0,0,4"/>
                        <WrapPanel x:Name="TagsHost"/>
                    </StackPanel>

                    <!-- DESCRIPTION -->
                    <TextBlock Text="DESCRIPTION / RELEASE NOTES" Style="{StaticResource MetaLabel}" Margin="0,0,0,4"/>
                    <Border Background="#FF0B1120" BorderBrush="#FF1E293B" BorderThickness="1" CornerRadius="6" Padding="10">
                        <TextBlock x:Name="DescriptionText" Text="No description provided."
                                   Foreground="#FFCBD5E1" FontSize="12.5" TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- FOOTER ACTIONS -->
        <DockPanel Grid.Row="3" Margin="0,12,0,0" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <Button x:Name="InstallBtn" Content="Download &amp; Install" Background="#FF065F46" BorderBrush="#FF10B981" Margin="0,0,8,0"
                        Click="OnInstallClick"/>
                <Button x:Name="SaveZipBtn" Content="Save .zip..." Margin="0,0,8,0"
                        Click="OnSaveZipClick"/>
                <Button x:Name="DeleteBtn" Content="Delete Theme" Background="#FF7F1D1D" BorderBrush="#FFEF4444" Visibility="Collapsed"
                        Click="OnDeleteClick"/>
            </StackPanel>

            <Button DockPanel.Dock="Right" Content="Close" IsCancel="True" Width="96"/>
        </DockPanel>
    </Grid>
</Window>
