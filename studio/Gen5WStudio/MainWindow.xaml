<Window x:Class="Gen5WStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Gen5WStudio.Controls"
        Title="Gen5W Studio — Ioniq 5 ThemePack v2 Customizer"
        Width="1580" Height="920" MinWidth="1220" MinHeight="740"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBgBrush}"
        Foreground="{StaticResource TextPrimaryBrush}">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#FF1B2C44" />
            <Setter Property="Foreground" Value="#FFF1F5F9" />
            <Setter Property="BorderBrush" Value="#FF334E73" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                    <Setter Property="Cursor" Value="Arrow" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#FF0D1522" />
            <Setter Property="Foreground" Value="#FFF1F5F9" />
            <Setter Property="BorderBrush" Value="#FF2E4466" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="CaretBrush" Value="#FF38BDF8" />
        </Style>
        <Style x:Key="ColorTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3" Padding="3,2">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="PART_SwatchBtn" Grid.Column="0" Width="18" Height="18" Margin="0,0,5,0"
                                        Padding="0" Cursor="Hand" Focusable="False" Background="Transparent"
                                        ToolTip="Open Color &amp; Opacity Picker">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border CornerRadius="3" BorderBrush="#FF64748B" BorderThickness="1" ClipToBounds="True">
                                                <Grid>
                                                    <Rectangle Fill="{StaticResource CheckerBrush}" />
                                                    <Rectangle Fill="{TemplateBinding Background}" />
                                                </Grid>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <ScrollViewer x:Name="PART_ContentHost" Grid.Column="1" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#FF0D1522" />
            <Setter Property="Foreground" Value="#FF0F172A" />
            <Setter Property="Padding" Value="6,4" />
        </Style>
        <Style TargetType="TextBlock" x:Key="FieldLabel">
            <Setter Property="Foreground" Value="#FF94A3B8" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,6,0,2" />
        </Style>
        <Style TargetType="ComboBoxItem" x:Key="CategorizedComboItemStyle">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsHeader}" Value="True">
                    <Setter Property="IsEnabled" Value="False" />
                    <Setter Property="Focusable" Value="False" />
                    <Setter Property="FontWeight" Value="Bold" />
                    <Setter Property="FontSize" Value="11" />
                    <Setter Property="Background" Value="#FFE2E8F0" />
                    <Setter Property="BorderBrush" Value="#FFCBD5E1" />
                    <Setter Property="BorderThickness" Value="0,1,0,1" />
                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                    <Setter Property="Padding" Value="6,6,6,5" />
                    <Setter Property="Margin" Value="0,3,0,1" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- TOP STUDIO TOOLBAR -->
        <Border Grid.Row="0" Background="{StaticResource PanelBgBrush}" BorderBrush="{StaticResource BorderBrushSubtle}" BorderThickness="0,0,0,1" Padding="12,6">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,12,2">
                    <TextBlock Text="GEN5W STUDIO" FontWeight="Bold" FontSize="15" Foreground="#FF38BDF8" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <Button Content="+ New Theme..." Background="#FF0F766E" BorderBrush="#FF14B8A6" Margin="0,0,6,0" Click="OnNewThemeClick" />
                    <TextBlock Text="Theme:" Foreground="#FF94A3B8" VerticalAlignment="Center" Margin="2,0,5,0" />
                    <ComboBox x:Name="ThemeSelectorCombo" Width="195" Margin="0,0,6,0" SelectionChanged="OnThemeSelectorChanged" />
                    <Button Content="Open..." ToolTip="Open a Theme folder OR Pack folder (loads ONLY themes inside it)" Margin="0,0,4,0" Click="OnOpenFolderClick" />
                    <Button x:Name="RecentBtn" Content="Recent ▾" ToolTip="Open a recently used theme or pack folder" Margin="0,0,4,0" Click="OnRecentDropdownClick" />
                    <Button x:Name="SaveBtn" Content="Save" ToolTip="Save changes to active theme" Margin="0,0,4,0" Click="OnSaveCurrentClick" />
                    <Button x:Name="SaveAsBtn" Content="Save As..." ToolTip="Save a copy of the active theme to another folder" Click="OnSaveFolderClick" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,12,2">
                    <Button x:Name="ExportUsbBtn" Content="Export to USB..."
                            ToolTip="Choose USB drive, manage/select pack themes, and optionally put the Gen5W Launcher NEMESIS installer onto USB"
                            Background="#FF065F46" BorderBrush="#FF10B981" Click="OnExportUsbClick" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,14,2">
                    <Button x:Name="ThemeStoreBtn" Content="Theme Store" ToolTip="Browse &amp; download themes from market.ioniqthemes.com" Background="#FF1E3A8A" BorderBrush="#FF3B82F6" Margin="0,0,4,0" Click="OnOpenThemeStoreClick" />
                    <Button x:Name="UploadStoreBtn" Content="Upload to Theme Store" ToolTip="Package ONLY the currently active theme as a safe .zip with screenshot thumbnail &amp; upload to Store" Background="#FF065F46" BorderBrush="#FF10B981" Margin="0,0,4,0" Click="OnUploadThemeStoreClick" />
                    <Button x:Name="AiContextBtn" Content="AI Context" ToolTip="Copy an up-to-date AI Agent prompt containing all Gen5W theme rules, sensors, car controls, and animated background specs" Background="#FF4C1D95" BorderBrush="#FF8B5CF6" Click="OnOpenAiContextClick" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,0,2">
                    <CheckBox x:Name="TopBarCheck" Content="90px Bar" Foreground="#FFCBD5E1" IsChecked="True" VerticalAlignment="Center" Margin="0,0,10,0" Checked="OnSimChanged" Unchecked="OnSimChanged" />
                    <TextBlock Text="HV %" Foreground="#FF94A3B8" VerticalAlignment="Center" Margin="0,0,3,0" />
                    <Slider x:Name="HvSlider" Width="70" Minimum="0" Maximum="100" Value="78" VerticalAlignment="Center" ValueChanged="OnSimChanged" />
                    <TextBlock x:Name="HvReadout" Text="78%" Width="34" Foreground="#FF38BDF8" FontWeight="Bold" VerticalAlignment="Center" />
                    <TextBlock Text="EXT" Foreground="#FF94A3B8" VerticalAlignment="Center" Margin="6,0,3,0" />
                    <Slider x:Name="TempSlider" Width="54" Minimum="-10" Maximum="115" Value="68" VerticalAlignment="Center" ValueChanged="OnSimChanged" />
                    <TextBlock x:Name="TempReadout" Text="68°F" Width="38" Foreground="#FF34D399" FontWeight="Bold" VerticalAlignment="Center" />
                    <CheckBox x:Name="ChargingCheck" Content="Chg" ToolTip="Charging Active" Foreground="#FF34D399" VerticalAlignment="Center" Margin="4,0,6,0" Checked="OnSimChanged" Unchecked="OnSimChanged" />
                    <CheckBox x:Name="ParkCheck" Content="Park" Foreground="#FFF1F5F9" IsChecked="True" VerticalAlignment="Center" Checked="OnSimChanged" Unchecked="OnSimChanged" />
                </StackPanel>
            </WrapPanel>
        </Border>

        <!-- MAIN WORKBENCH -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="420" />
            </Grid.ColumnDefinitions>

            <!-- LEFT: HIERARCHY & PALETTE -->
            <Border x:Name="LeftSidebarPanel" Grid.Column="0" Background="{StaticResource PanelBgBrush}" BorderBrush="{StaticResource BorderBrushSubtle}" BorderThickness="0,0,1,0" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="LAYOUT HIERARCHY" FontWeight="Bold" Foreground="#FF7DD3FC" Margin="2,2,0,8" />
                    <TreeView x:Name="HierarchyTree" Grid.Row="1" Background="#FF0D1522" BorderBrush="{StaticResource BorderBrushSubtle}"
                              Foreground="#FFE2E8F0" SelectedItemChanged="OnTreeSelectedChanged"
                              AllowDrop="True"
                              PreviewMouseLeftButtonDown="OnTreePreviewMouseDown"
                              PreviewMouseMove="OnTreePreviewMouseMove"
                              DragOver="OnTreeDragOver"
                              Drop="OnTreeDrop">
                        <TreeView.Resources>
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#FF0369A1" />
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFFFF" />
                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#FF1E3A5F" />
                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#FFF1F5F9" />
                        </TreeView.Resources>
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="{x:Type TreeViewItem}">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                                <Setter Property="Foreground" Value="#FFE2E8F0" />
                                <Setter Property="Padding" Value="2,1" />
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding TreeChildren}">
                                <TextBlock Text="{Binding DisplayLabel}" Padding="3,2" />
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>

                    <StackPanel Grid.Row="2" Margin="0,8,0,0">
                        <TextBlock Text="ADD COMPOSABLE ELEMENT" FontWeight="Bold" Foreground="#FF7DD3FC" FontSize="11" Margin="2,0,0,4" />
                        <UniformGrid Columns="2">
                            <Button Content="+ Panel Group" Click="OnAddPanelClick" />
                            <Button Content="+ Text / Sensor" Click="OnAddTextClick" />
                            <Button Content="+ Percent Bar" Click="OnAddProgressBarClick" />
                            <Button Content="+ Gauge Ring" Click="OnAddRingClick" />
                            <Button Content="+ Icon / Image" Click="OnAddImageClick" />
                            <Button Content="+ Clock" Click="OnAddClockClick" />
                            <Button Content="+ Pager" Click="OnAddPagerClick" />
                            <Button Content="+ Page" Click="OnAddPageClick" />
                            <Button Content="+ Page Bar" Click="OnAddPageIndicatorClick" />
                            <Button Content="+ Spacer" Click="OnAddSpacerClick" />
                        </UniformGrid>

                        <TextBlock Text="START FROM PRESET PANEL (EDITABLE)" FontWeight="Bold" Foreground="#FF34D399" FontSize="11" Margin="2,8,0,4" />
                        <UniformGrid Columns="3">
                            <Button Content="+ EV Hero" Background="#FF0D3B4C" BorderBrush="#FF0284C7" Click="OnAddPresetEvHeroClick" />
                            <Button Content="+ Tile" Background="#FF0D3B4C" BorderBrush="#FF0284C7" Click="OnAddPresetTileClick" />
                            <Button Content="+ Pill" Background="#FF0D3B4C" BorderBrush="#FF0284C7" Click="OnAddPresetPillClick" />
                        </UniformGrid>

                        <TextBlock Text="ARRANGE / RE-PARENT (OR DRAG IN TREE)" FontWeight="Bold" Foreground="#FF7DD3FC" FontSize="11" Margin="2,8,0,4" />
                        <UniformGrid Columns="4">
                            <Button Content="Up" ToolTip="Move earlier among siblings" Click="OnMoveUpClick" />
                            <Button Content="Down" ToolTip="Move later among siblings" Click="OnMoveDownClick" />
                            <Button Content="Nest &#x2192;" ToolTip="Move into adjacent sibling panel container" Click="OnNestIntoSiblingClick" />
                            <Button Content="&#x2190; Out" ToolTip="Unnest out of current parent panel up one level" Click="OnUnnestToParentClick" />
                            <Button Content="Wrap" ToolTip="Wrap selected element in a new [flex_col] group panel" Click="OnWrapInPanelClick" />
                            <Button x:Name="MoveToBtn" Content="Move To&#x2026;" ToolTip="Pick any panel in the hierarchy to move this item into" Click="OnMoveToPanelClick" />
                            <Button Content="Dup" ToolTip="Duplicate selected item" Click="OnDuplicateClick" />
                            <Button Content="Del" ToolTip="Delete selected item" Background="#FF7F1D1D" BorderBrush="#FFEF4444" Click="OnDeleteClick" />
                        </UniformGrid>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- CENTER: LIVE 1920x720 WYSIWYG STAGE -->
            <Grid Grid.Column="1" Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,8">
                    <TextBlock x:Name="PackHeaderText" Text="1920x720 Live Automotive Preview" FontWeight="Bold" Foreground="#FFE2E8F0" VerticalAlignment="Center" />
                    <TextBlock x:Name="FreeformHintText" DockPanel.Dock="Right" Text="Click any panel/element to customize • Drag/resize in [freeform] panels" Foreground="#FF94A3B8" FontSize="12" VerticalAlignment="Center" />
                </DockPanel>

                <controls:StudioCanvasControl x:Name="StudioCanvas" Grid.Row="1" />

                <Border x:Name="EmptyWorkspaceOverlay" Grid.Row="1"
                        Background="#FF0B1220" BorderBrush="#FF1E293B" BorderThickness="1" CornerRadius="10" Padding="28" Visibility="Collapsed">
                    <Grid MaxWidth="660" VerticalAlignment="Center" HorizontalAlignment="Center" Width="620">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,18">
                            <TextBlock Text="GEN5W STUDIO" FontSize="22" FontWeight="Bold" Foreground="#FF38BDF8" />
                            <TextBlock Text="Empty workspace — open a recent theme, start a blank layout, or browse community themes on the Theme Store."
                                       Foreground="#FF94A3B8" FontSize="13" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>

                        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,22">
                            <Button Content="+ New Theme..." Background="#FF0F766E" BorderBrush="#FF14B8A6" Padding="10,10" Margin="0,0,4,0" Click="OnNewThemeClick" />
                            <Button Content="Open Theme / Pack..." Background="#FF1E293B" BorderBrush="#FF334155" Padding="10,10" Margin="3,0" Click="OnOpenFolderClick" />
                            <Button Content="Browse Theme Store" Background="#FF1E3A8A" BorderBrush="#FF3B82F6" Padding="10,10" Margin="3,0" Click="OnOpenThemeStoreClick" />
                            <Button Content="AI Context Prompt" Background="#FF4C1D95" BorderBrush="#FF8B5CF6" Padding="10,10" Margin="4,0,0,0" Click="OnOpenAiContextClick" />
                        </UniformGrid>

                        <DockPanel Grid.Row="2" Margin="0,0,0,8">
                            <Button x:Name="ClearRecentBtn" DockPanel.Dock="Right" Content="Clear History" Padding="9,3" FontSize="11" Click="OnClearRecentClick" />
                            <TextBlock Text="RECENTLY OPENED" FontWeight="Bold" FontSize="12" Foreground="#FF7DD3FC" VerticalAlignment="Center" />
                        </DockPanel>

                        <Border Grid.Row="3" Background="#FF070D18" BorderBrush="#FF1E293B" BorderThickness="1" CornerRadius="8" Padding="8" MinHeight="160" MaxHeight="290">
                            <Grid>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="RecentListHost" />
                                </ScrollViewer>
                                <TextBlock x:Name="NoRecentText"
                                           Text="No recently opened themes or packs yet."
                                           Foreground="#FF64748B" FontSize="12"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Background="{StaticResource CardBgBrush}" CornerRadius="6" Padding="10,6" Margin="0,8,0,0">
                    <DockPanel>
                        <TextBlock x:Name="ConversionProgressText" DockPanel.Dock="Right" Text="Ready" Foreground="#FF34D399" FontSize="12" VerticalAlignment="Center" />
                        <TextBlock x:Name="SelectionSummaryText" Text="Select a node on the canvas or tree" Foreground="#FFCBD5E1" FontSize="12" VerticalAlignment="Center" />
                    </DockPanel>
                </Border>
            </Grid>

            <!-- RIGHT: INSPECTOR + BACKDROP/VIDEO CONVERTER -->
            <Border x:Name="RightInspectorPanel" Grid.Column="2" Background="{StaticResource PanelBgBrush}" BorderBrush="{StaticResource BorderBrushSubtle}" BorderThickness="1,0,0,0">
                <TabControl x:Name="RightTabs" Background="Transparent" BorderThickness="0">
                    <TabItem Header="Selected Element">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                            <StackPanel x:Name="NodeInspectorPanel" KeyDown="OnInspectorPanelKeyDown">
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="SelectParentBtn" Grid.Column="0" Content="↑ Select Parent Panel" Click="OnSelectParentClick" />
                                    <Button x:Name="BreakApartBtn" Grid.Column="1" Content="Break Apart Preset → Panel" Background="#FF0F766E" BorderBrush="#FF14B8A6" Visibility="Collapsed" Click="OnBreakApartClick" />
                                </Grid>

                                <TextBlock Text="Node ID &amp; Kind" FontWeight="Bold" Foreground="#FF7DD3FC" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                        <TextBlock Text="ID" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="NodeIdBox" LostFocus="OnInspectorTextApplied" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                        <TextBlock Text="Kind / Panel Layout" Style="{StaticResource FieldLabel}" />
                                        <ComboBox x:Name="NodeTypeCombo" SelectionChanged="OnNodeTypeChanged" />
                                    </StackPanel>
                                </Grid>

                                <!-- WIDGET CONTENT & TELEMETRY -->
                                <StackPanel x:Name="WidgetFieldsGroup">
                                    <StackPanel x:Name="ContentSensorSection">
                                        <TextBlock x:Name="ContentHeaderText" Text="Content &amp; Sensor Data (HMG-API)" FontWeight="Bold" Foreground="#FF7DD3FC" Margin="0,12,0,2" />
                                        <StackPanel x:Name="TitleFieldGroup">
                                            <TextBlock Text="Text / Title (supports {value} or {hv.soc}, {battery12v.soc}, etc.)" Style="{StaticResource FieldLabel}" />
                                            <TextBox x:Name="TitleBox" LostFocus="OnInspectorTextApplied" />
                                        </StackPanel>

                                        <Grid x:Name="SubBadgeRow">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition x:Name="SubtitleCol" Width="2*"/>
                                                <ColumnDefinition x:Name="BadgeCol" Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel x:Name="SubtitleCell" Grid.Column="0" Margin="0,0,4,0">
                                                <TextBlock Text="Subtitle / Second Line" Style="{StaticResource FieldLabel}" />
                                                <TextBox x:Name="SubtitleBox" LostFocus="OnInspectorTextApplied" />
                                            </StackPanel>
                                            <StackPanel x:Name="BadgeCell" Grid.Column="1" Margin="4,0,0,0">
                                                <TextBlock Text="Badge Chip" Style="{StaticResource FieldLabel}" />
                                                <TextBox x:Name="BadgeBox" LostFocus="OnInspectorTextApplied" />
                                            </StackPanel>
                                        </Grid>

                                        <StackPanel x:Name="SensorBindGroup">
                                            <TextBlock Text="Bind Data Sensor — GET / Read Live State (independent per widget)" Style="{StaticResource FieldLabel}" />
                                            <ComboBox x:Name="TelemetryKeyCombo"
                                                      IsEditable="True"
                                                      TextSearch.TextPath="Key"
                                                      ItemContainerStyle="{StaticResource CategorizedComboItemStyle}"
                                                      SelectionChanged="OnTelemetrySensorChanged"
                                                      LostFocus="OnInspectorTextApplied">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding DropdownLabel}" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </StackPanel>

                                        <Grid x:Name="SensorUnitRangeRow">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition x:Name="UnitCol" Width="*"/>
                                                <ColumnDefinition x:Name="MinValCol" Width="*"/>
                                                <ColumnDefinition x:Name="MaxValCol" Width="*"/>
                                                <ColumnDefinition x:Name="BarDirCol" Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel x:Name="UnitCell" Grid.Column="0" Margin="0,0,3,0">
                                                <TextBlock Text="Unit (optional)" Style="{StaticResource FieldLabel}" />
                                                <TextBox x:Name="UnitBox" ToolTip="e.g. %, °C, °F, mph, km/h" LostFocus="OnInspectorTextApplied" />
                                            </StackPanel>
                                            <StackPanel x:Name="MinValCell" Grid.Column="1" Margin="2,0">
                                                <TextBlock Text="Bar/Ring Min" Style="{StaticResource FieldLabel}" />
                                                <TextBox x:Name="MinValBox" LostFocus="OnInspectorTextApplied" />
                                            </StackPanel>
                                            <StackPanel x:Name="MaxValCell" Grid.Column="2" Margin="2,0">
                                                <TextBlock Text="Bar/Ring Max" Style="{StaticResource FieldLabel}" />
                                                <TextBox x:Name="MaxValBox" LostFocus="OnInspectorTextApplied" />
                                            </StackPanel>
                                            <StackPanel x:Name="BarDirCell" Grid.Column="3" Margin="3,0,0,0">
                                                <TextBlock Text="Bar Dir" Style="{StaticResource FieldLabel}" />
                                                <ComboBox x:Name="OrientationCombo" SelectionChanged="OnInspectorComboChanged">
                                                    <ComboBoxItem Content="horizontal" /><ComboBoxItem Content="vertical" />
                                                </ComboBox>
                                            </StackPanel>
                                        </Grid>
                                        <StackPanel x:Name="SensorOptionsRow" Orientation="Horizontal" Margin="0,6,0,2">
                                            <CheckBox x:Name="ShowTextCheck" Content="Show Value Text on Bar" Foreground="#FFCBD5E1" Margin="0,0,14,0" Checked="OnInspectorCheckChanged" Unchecked="OnInspectorCheckChanged" />
                                            <CheckBox x:Name="WrapTextCheck" Content="Wrap Multi-line Text" Foreground="#FFCBD5E1" Checked="OnInspectorCheckChanged" Unchecked="OnInspectorCheckChanged" />
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- TYPOGRAPHY -->
                                    <StackPanel x:Name="TypographySection">
                                        <TextBlock x:Name="TypographyHeaderText" Text="Typography (Independent per Element)" FontWeight="Bold" Foreground="#FF7DD3FC" Margin="0,12,0,2" />
                                        <Grid x:Name="FontRow">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <ComboBox x:Name="FontCombo" Grid.Column="0" IsEditable="True" SelectionChanged="OnInspectorComboChanged" LostFocus="OnInspectorTextApplied" />
                                            <Button Content="+ .TTF/.OTF" Grid.Column="1" ToolTip="Import TrueType/OpenType font into ThemePack fonts/" Click="OnImportFontClick" />
                                        </Grid>
                                        <Grid x:Name="FontSizesRow">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition x:Name="TitleSizeCol" Width="*"/>
                                                <ColumnDefinition x:Name="SubSizeCol" Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel x:Name="TitleSizeCell" Grid.Column="0" Margin="0,0,4,0">
                                                <TextBlock Text="Font Size (px)" Style="{StaticResource FieldLabel}" />
                                                <TextBox x:Name="TitleSizeBox" LostFocus="OnInspectorTextApplied" />
                                            </StackPanel>
                                            <StackPanel x:Name="SubSizeCell" Grid.Column="1" Margin="4,0,6,0">
                                                <TextBlock Text="Sub Size (px)" Style="{StaticResource FieldLabel}" />
                                                <TextBox x:Name="SubSizeBox" LostFocus="OnInspectorTextApplied" />
                                            </StackPanel>
                                            <CheckBox x:Name="BoldCheck" Grid.Column="2" Content="Bold" Foreground="#FFF1F5F9" VerticalAlignment="Bottom" Margin="4,0,8,6" Checked="OnInspectorCheckChanged" Unchecked="OnInspectorCheckChanged" />
                                            <CheckBox x:Name="ItalicCheck" Grid.Column="3" Content="Italic" Foreground="#FFF1F5F9" VerticalAlignment="Bottom" Margin="0,0,2,6" Checked="OnInspectorCheckChanged" Unchecked="OnInspectorCheckChanged" />
                                        </Grid>
                                        <Grid x:Name="TextColorsAlignRow">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition x:Name="TextColorCol" Width="*"/>
