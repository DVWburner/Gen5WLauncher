                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                        <TextBlock Text="Speed / Distance Unit" Style="{StaticResource FieldLabel}" />
                                        <ComboBox x:Name="ThemeSpeedUnitCombo" SelectionChanged="OnBgModeChanged">
                                            <ComboBoxItem Content="MPH / mi (US)" Tag="mph" />
                                            <ComboBoxItem Content="km/h / km (Metric)" Tag="kmh" />
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                        <TextBlock Text="Temperature Unit" Style="{StaticResource FieldLabel}" />
                                        <ComboBox x:Name="ThemeTempUnitCombo" SelectionChanged="OnBgModeChanged">
                                            <ComboBoxItem Content="&#x00B0;F (Fahrenheit)" Tag="F" />
                                            <ComboBoxItem Content="&#x00B0;C (Celsius)" Tag="C" />
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Live Car Telemetry Simulator" FontWeight="Bold" Foreground="#FF7DD3FC" Margin="0,14,0,4" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="112"/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="12V Aux %" Foreground="#FF94A3B8" VerticalAlignment="Center" Margin="0,0,8,4" />
                                    <Slider x:Name="Aux12Slider" Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="100" Value="92" VerticalAlignment="Center" Margin="0,0,6,4" ValueChanged="OnSimChanged" />
                                    <TextBlock x:Name="Aux12Readout" Grid.Row="0" Grid.Column="2" Text="92%" Foreground="#FF38BDF8" VerticalAlignment="Center" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Pack Min Temp" Foreground="#FF94A3B8" VerticalAlignment="Center" Margin="0,0,8,4" />
                                    <Slider x:Name="PackTempSlider" Grid.Row="1" Grid.Column="1" Minimum="-20" Maximum="60" Value="22" VerticalAlignment="Center" Margin="0,0,6,4" ValueChanged="OnSimChanged" />
                                    <TextBlock x:Name="PackTempReadout" Grid.Row="1" Grid.Column="2" Text="72&#x00B0;F (22&#x00B0;C)" Foreground="#FF34D399" VerticalAlignment="Center" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Vehicle Speed" Foreground="#FF94A3B8" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <Slider x:Name="SpeedSlider" Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="160" Value="0" VerticalAlignment="Center" Margin="0,0,6,0" ValueChanged="OnSimChanged" />
                                    <TextBlock x:Name="SpeedReadout" Grid.Row="2" Grid.Column="2" Text="0 km/h (0 mph)" Foreground="#FFF1F5F9" VerticalAlignment="Center" />
                                </Grid>

                                <TextBlock Text="Backdrop Renderer" FontWeight="Bold" Foreground="#FF7DD3FC" Margin="0,14,0,2" />
                                <TextBlock Text="Backdrop Mode" Style="{StaticResource FieldLabel}" />
                                <ComboBox x:Name="BgModeCombo" SelectionChanged="OnBgModeChanged" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,4,0"><TextBlock Text="Primary Color" Style="{StaticResource FieldLabel}" /><TextBox x:Name="BgPrimaryBox" Style="{StaticResource ColorTextBoxStyle}" LostFocus="OnThemeMetaApplied" /></StackPanel>
                                    <StackPanel Grid.Column="1" Margin="4,0,0,0"><TextBlock Text="Secondary Color" Style="{StaticResource FieldLabel}" /><TextBox x:Name="BgSecondaryBox" Style="{StaticResource ColorTextBoxStyle}" LostFocus="OnThemeMetaApplied" /></StackPanel>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,4,0"><TextBlock Text="Accent Glow" Style="{StaticResource FieldLabel}" /><TextBox x:Name="BgAccentBox" Style="{StaticResource ColorTextBoxStyle}" LostFocus="OnThemeMetaApplied" /></StackPanel>
                                    <StackPanel Grid.Column="1" Margin="4,0,0,0"><TextBlock Text="Media Dim Scrim" Style="{StaticResource FieldLabel}" /><TextBox x:Name="BgDimBox" Style="{StaticResource ColorTextBoxStyle}" LostFocus="OnThemeMetaApplied" /></StackPanel>
                                </Grid>
                                <Button Content="Import Static Wallpaper Image (.png / .jpg)..." Margin="0,10,0,4" Click="OnImportWallpaperClick" />

                                <Border Background="#FF162235" BorderBrush="#FF263B59" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,12,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Video / GIF -> Car Animated Format Converter" FontWeight="Bold" Foreground="#FF34D399" />
                                        <TextBlock Text="Converts .mp4, .mov, .wmv, .avi, or .gif natively via Windows Media Foundation into car-safe VPU-free frame loops (8:3 center-cropped for KitKat TCC803x)."
                                                   TextWrapping="Wrap" Foreground="#FF94A3B8" FontSize="11" Margin="0,4,0,6" />
                                        <TextBlock Text="Output Resolution" Style="{StaticResource FieldLabel}" />
                                        <ComboBox x:Name="VideoResCombo" SelectedIndex="0">
                                            <ComboBoxItem Content="960 x 360 (Recommended Car Wallpaper)" Tag="960,360" />
                                            <ComboBoxItem Content="1280 x 480 (HD Wallpaper)" Tag="1280,480" />
                                            <ComboBoxItem Content="640 x 240 (Ultra Fast / Compact)" Tag="640,240" />
                                        </ComboBox>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                                <TextBlock Text="Target FPS" Style="{StaticResource FieldLabel}" />
                                                <TextBox x:Name="VideoFpsBox" Text="16" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                                <TextBlock Text="Max Clip Sec" Style="{StaticResource FieldLabel}" />
                                                <TextBox x:Name="VideoSecBox" Text="6" />
                                            </StackPanel>
                                        </Grid>
                                        <Button x:Name="ConvertVideoBgBtn" Content="Convert Video / GIF as Wallpaper..." Background="#FF065F46" BorderBrush="#FF10B981" Margin="0,10,0,2" Click="OnImportVideoWallpaperClick" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>

        <!-- BOTTOM STATUS BAR -->
        <Border Grid.Row="2" Background="#FF070C14" BorderBrush="{StaticResource BorderBrushSubtle}" BorderThickness="0,1,0,0" Padding="12,5">
            <DockPanel>
                <TextBlock x:Name="WorkspacePathText" DockPanel.Dock="Right" Foreground="#FF64748B" FontSize="11" />
                <TextBlock x:Name="StatusFooterText" Text="Ready" Foreground="#FF94A3B8" FontSize="12" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
