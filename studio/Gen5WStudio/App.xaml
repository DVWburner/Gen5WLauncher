<Application x:Class="Gen5WStudio.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="AppBgBrush" Color="#FF0A101B" />
        <SolidColorBrush x:Key="PanelBgBrush" Color="#FF111A29" />
        <SolidColorBrush x:Key="CardBgBrush" Color="#FF162235" />
        <SolidColorBrush x:Key="BorderBrushSubtle" Color="#FF263B59" />
        <SolidColorBrush x:Key="AccentBrush" Color="#FF38BDF8" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFF1F5F9" />
        <SolidColorBrush x:Key="TextMutedBrush" Color="#FF94A3B8" />
        <DrawingBrush x:Key="CheckerBrush" TileMode="Tile" Viewport="0,0,10,10" ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#FFCBD5E1">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,10,10" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#FF475569">
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <RectangleGeometry Rect="0,0,5,5" />
                                <RectangleGeometry Rect="5,5,5,5" />
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
    </Application.Resources>
</Application>
