<Window x:Class="Gen5WStudio.ExportUsbDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Export to USB &amp; Pack Manager"
        Width="720" Height="680" MinWidth="600" MinHeight="540"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBgBrush}"
        Foreground="{StaticResource TextPrimaryBrush}">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#FF1B2C44" />
            <Setter Property="Foreground" Value="#FFF1F5F9" />
            <Setter Property="BorderBrush" Value="#FF334E73" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                    <Setter Property="Cursor" Value="Arrow" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Margin="16" Padding="16" Background="{StaticResource PanelBgBrush}" BorderBrush="{StaticResource BorderBrushSubtle}" BorderThickness="1" CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <StackPanel Grid.Row="0" Margin="0,0,0,12">
                <TextBlock Text="EXPORT TO USB &amp; PACK MANAGER" FontSize="15" FontWeight="Bold" Foreground="#FF38BDF8" />
                <TextBlock Text="Select a removable USB drive, choose themes from your pack, and optionally include the NEMESIS launcher installer."
                           Foreground="#FF94A3B8" FontSize="11.5" TextWrapping="Wrap" Margin="0,3,0,0" />
            </StackPanel>

            <!-- 1. USB DRIVE CHOOSER -->
            <Border Grid.Row="1" Background="#FF0E1726" BorderBrush="#FF243752" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="1. DESTINATION USB DRIVE" FontWeight="Bold" FontSize="11.5" Foreground="#FF7DD3FC" Margin="0,0,0,6" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="UsbDriveCombo" Grid.Column="0" Height="32" VerticalContentAlignment="Center" Margin="0,0,8,0"
                                  SelectionChanged="OnUsbSelectionChanged" />
                        <Button x:Name="RefreshUsbBtn" Grid.Column="1" Content="↻ Refresh USB Drives" Padding="12,5" Click="OnRefreshUsbClick" />
                    </Grid>
                    <TextBlock x:Name="UsbStatusText" Text="Scanning removable USB drives..." Foreground="#FF94A3B8" FontSize="11" Margin="0,5,0,0" />
                </StackPanel>
            </Border>

            <!-- 2. CHOOSE PACK & THEMES -->
            <Border Grid.Row="2" Background="#FF0E1726" BorderBrush="#FF243752" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,4">
                        <TextBlock x:Name="CountText" DockPanel.Dock="Right" Text="0 selected" Foreground="#FF34D399" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <CheckBox x:Name="IncludeThemesCheck" IsChecked="True" Foreground="#FF7DD3FC" FontWeight="Bold" FontSize="11.5"
                                  Content="2. EXPORT SELECTED THEMES TO USB:\Gen5WLauncher\packs\"
                                  Checked="OnExportModeChanged" Unchecked="OnExportModeChanged" />
                    </DockPanel>

                    <StackPanel Grid.Row="1" Margin="0,2,0,8">
                        <TextBlock x:Name="PackPathSummary" Foreground="#FF94A3B8" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6" />
                        <WrapPanel Orientation="Horizontal">
                            <Button x:Name="ImportFolderBtn" Content="+ Import Theme Folder..." Padding="9,4" Margin="0,0,6,2" Background="#FF0F766E" BorderBrush="#FF14B8A6" Click="OnImportThemeIntoPackClick" />
                            <Button x:Name="ImportZipBtn" Content="+ Import Theme .zip..." Padding="9,4" Margin="0,0,6,2" Background="#FF1D4ED8" BorderBrush="#FF3B82F6" Click="OnImportThemeZipClick" />
                            <Button x:Name="SelectAllBtn" Content="Select All" Padding="9,4" Margin="0,0,6,2" Click="OnSelectAllClick" />
                            <Button x:Name="ClearAllBtn" Content="Clear" Padding="9,4" Margin="0,0,6,2" Click="OnClearAllClick" />
                        </WrapPanel>
                    </StackPanel>

                    <Border Grid.Row="2" Background="#FF0B121E" BorderBrush="{StaticResource BorderBrushSubtle}" BorderThickness="1" CornerRadius="6" Padding="6">
                        <Grid>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="ThemeRowsList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#FF131E30" BorderBrush="#FF243752" BorderThickness="1" CornerRadius="6" Padding="10,7" Margin="0,0,0,6">
                                                <DockPanel>
                                                    <Button DockPanel.Dock="Right" Content="Remove" Padding="8,3" FontSize="11"
                                                            Background="#FF5F1D1D" BorderBrush="#FFEF4444"
                                                            Visibility="{Binding DeleteVisibility}"
                                                            ToolTip="Delete this theme from the active pack"
                                                            Tag="{Binding}" Click="OnDeleteRowClick" />
                                                    <Border DockPanel.Dock="Right" Background="#FF1B2C44" CornerRadius="4" Padding="7,2" Margin="0,0,8,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Badge}" Foreground="#FF7DD3FC" FontSize="11" FontWeight="SemiBold" />
                                                    </Border>
                                                    <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" VerticalAlignment="Center"
                                                              Foreground="#FFF1F5F9" Click="OnRowCheckChanged">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" Foreground="#FFF1F5F9" />
                                                            <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="#FF94A3B8" />
                                                        </StackPanel>
                                                    </CheckBox>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <TextBlock x:Name="NoThemesNotice"
                                       Text="No active theme or pack is currently open. You can import themes above, or uncheck theme export to prepare a NEMESIS-only USB installer stick below."
                                       Foreground="#FF64748B" FontSize="12" TextWrapping="Wrap" TextAlignment="Center"
                                       VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20" Visibility="Collapsed" />
                        </Grid>
                    </Border>

                    <CheckBox x:Name="PruneCheck" Grid.Row="3" IsChecked="True" Foreground="#FFCBD5E1" Margin="0,8,0,0"
                              Content="Clean destination packs folder (remove unchecked themes from target folder / USB)" />
                </Grid>
            </Border>

            <!-- 3. NEMESIS LAUNCHER INSTALLER -->
            <Border Grid.Row="3" Background="#FF111C31" BorderBrush="#FF2C4D75" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                <StackPanel>
                    <CheckBox x:Name="IncludeNemesisInstallerCheck" Foreground="#FF7DD3FC" FontWeight="Bold" FontSize="12"
                              Content="3. INCLUDE GEN5W LAUNCHER NEMESIS INSTALLER ON USB ROOT"
                              Checked="OnExportModeChanged" Unchecked="OnExportModeChanged" />
                    <TextBlock Text="Copies NEMESIS.data, packages/hmgapi.gen5w-launcher.zip, and README.txt onto the root of the USB drive to install or update Gen5W Launcher without the NEMESIS Store."
                               Foreground="#FF94A3B8" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,8" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="InstallerSourceText" Grid.Column="0" Text="Locating bundled installer..."
                                   Foreground="#FFCBD5E1" FontSize="11.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                        <Button Grid.Column="1" Content="Browse .zip..." Padding="10,4" FontSize="11" Margin="0,0,6,0" Click="OnBrowseInstallerZipClick" />
                        <Button x:Name="ResetInstallerBtn" Grid.Column="2" Content="Default" Padding="10,4" FontSize="11" Visibility="Collapsed" Click="OnResetInstallerClick" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- BOTTOM ACTIONS -->
            <DockPanel Grid.Row="4">
                <Button DockPanel.Dock="Left" Content="Close" Width="90" IsCancel="True" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="SavePackFolderBtn" Content="Save Pack to Folder..." Margin="0,0,8,0" Click="OnSavePackFolderClick" />
                    <Button x:Name="ExportUsbBtn" Content="Export to USB" Padding="18,7" Background="#FF065F46" BorderBrush="#FF10B981" Click="OnExportToUsbClick" />
                </StackPanel>
            </DockPanel>
        </Grid>
    </Border>
</Window>
